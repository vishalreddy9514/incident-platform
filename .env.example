# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real secrets.

# ---- PostgreSQL ----
POSTGRES_DB=incident_platform
POSTGRES_USER=incident_platform
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
# Only consumed by the backend when it runs as a container itself (env_file: .env in
# docker-compose.yml) — `mvn spring-boot:run` never loads this file, so it falls back to
# application.yml's own `localhost` default instead. Set to the compose service name here since
# that's the only path where this value is actually read.
POSTGRES_HOST=postgres

# ---- Redis ----
REDIS_PORT=6379
REDIS_HOST=redis

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes-for-hs256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Creates one ADMIN account on first startup if no admin exists yet (see AdminBootstrapRunner) -
# needed to reach any ADMIN-only endpoint locally, since registration only ever creates USER
# accounts. Leave both blank to skip bootstrapping entirely (e.g. in a shared/production env).
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_INTERNAL_TOKEN=change-me-shared-internal-token

# ---- AI service (FastAPI) ----
AI_SERVICE_PORT=8000
# "mock" (default) needs no API key and is what CI/local dev run against (see ADR-0011).
# Set to "openai" plus LLM_API_KEY/LLM_MODEL below to call a real hosted model instead.
LLM_PROVIDER=mock
LLM_API_KEY=set-your-provider-key-here
LLM_MODEL=set-your-model-name-here

# ---- Frontend (Vite) ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
