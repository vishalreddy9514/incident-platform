# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real secrets.

# ---- PostgreSQL ----
POSTGRES_DB=incident_platform
POSTGRES_USER=incident_platform
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes-for-hs256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
CORS_ALLOWED_ORIGIN=http://localhost:5173
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_INTERNAL_TOKEN=change-me-shared-internal-token

# ---- AI service (FastAPI) ----
AI_SERVICE_PORT=8000
LLM_PROVIDER=openai
LLM_API_KEY=set-your-provider-key-here
LLM_MODEL=set-your-model-name-here

# ---- Frontend (Vite) ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
