# Copy this file to .env for local frontend development (cd frontend && cp .env.example .env).
# Vite only reads env files from THIS directory, not the monorepo root's .env — despite both
# existing, they serve different processes (the Java backend reads the root one via
# docker-compose/Spring; the frontend build reads this one via Vite). Kept deliberately separate
# rather than trying to share one file across two different tools' env-loading conventions.

VITE_API_BASE_URL=http://localhost:8080/api/v1
